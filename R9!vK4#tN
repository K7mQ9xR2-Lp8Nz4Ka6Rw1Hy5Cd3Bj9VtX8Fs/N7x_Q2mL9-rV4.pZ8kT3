local theme = {
	background = Color3.fromRGB(14, 8, 22),
	headerbackground = Color3.fromRGB(10, 4, 18),
	sidebarbackground = Color3.fromRGB(8, 2, 16),
	buttonbackground = Color3.fromRGB(28, 16, 44),
	inputbackground = Color3.fromRGB(22, 12, 36),
	accentstroke = Color3.fromRGB(190, 60, 255),
	accentfill = Color3.fromRGB(190, 60, 255),
	accentselected = Color3.fromRGB(45, 15, 70),
	textprimary = Color3.fromRGB(255, 255, 255),
	textsecondary = Color3.fromRGB(200, 160, 240),
	textmuted = Color3.fromRGB(235, 210, 255),
