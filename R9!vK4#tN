function tabmt:addslider(text, min, max, default, callback, useside)
	local parent = useside and self.side or self.main
	min = min or 0
	max = max or 100
	default = math.clamp(default or min, min, max)

	local frame = create("Frame", {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = theme.buttonbackground,
		BorderSizePixel = 0
	})
	addcorner(frame)
	addstroke(frame, Color3.fromRGB(60, 30, 90), 1)

	create("TextLabel", {
		Parent = frame,
		Size = UDim2.new(1, -70, 0, 20),
		Position = UDim2.new(0, 10, 0, 4),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = theme.textmuted,
		Font = theme.fontbody,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		BorderSizePixel = 0
	})

	local valuebox = create("TextBox", {
		Parent = frame,
		Size = UDim2.new(0, 50, 0, 20),
		Position = UDim2.new(1, -60, 0, 4),
		BackgroundColor3 = theme.inputbackground,
		TextColor3 = theme.textprimary,
		Font = theme.fontbody,
		TextSize = 12,
		Text = tostring(default),
		ClearTextOnFocus = false,
		BorderSizePixel = 0
	})
	addcorner(valuebox, 5)

	local track = create("Frame", {
		Parent = frame,
		Size = UDim2.new(1, -20, 0, 6),
		Position = UDim2.new(0, 10, 1, -14),
		BackgroundColor3 = theme.inputbackground,
		BorderSizePixel = 0
	})
	addcorner(track, 3)

	local fill = create("Frame", {
		Parent = track,
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = theme.accentfill,
		BorderSizePixel = 0
	})
	addcorner(fill, 3)

	local knob = create("Frame", {
		Parent = track,
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(0, -6, 0.5, -6),
		BackgroundColor3 = theme.textprimary,
		ZIndex = 5,
		BorderSizePixel = 0
	})
	addcorner(knob, 6)

	local value = default

	local function setvalue(newvalue, skiptext)
		newvalue = math.clamp(newvalue, min, max)
		value = newvalue
		local percent = (max - min) == 0 and 0 or (newvalue - min) / (max - min)
		fill.Size = UDim2.new(percent, 0, 1, 0)
		knob.Position = UDim2.new(percent, -6, 0.5, -6)
		if not skiptext then
			valuebox.Text = tostring(math.floor(newvalue * 100) / 100)
		end
		if callback then
			callback(newvalue)
		end
	end

	setvalue(default)

	local sliding = false

	local function updateslider(x)
		local percent = (x - track.AbsolutePosition.X) / track.AbsoluteSize.X
		setvalue(min + percent * (max - min))
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			updateslider(input.Position.X)
		end
	end)

	track.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	userinputservice.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateslider(input.Position.X)
		end
	end)

	userinputservice.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	valuebox.FocusLost:Connect(function()
		local num = tonumber(valuebox.Text)
		if num then
			setvalue(num, true)
			valuebox.Text = tostring(value)
		else
			valuebox.Text = tostring(value)
		end
	end)

	return {
		set = setvalue,
		get = function()
			return value
		end
	}
end

function tabmt:adddropdown(title, options, useside, multiselect)
	if useside == nil then
		useside = true
	end
	local parent = useside and self.side or self.main
	local lib = self.library

	local optionheight = 24
	local optionpadding = 2
	local maxheight = 150

	local frame = create("Frame", {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 2,
		BorderSizePixel = 0
	})
	create("UIListLayout", {
		Parent = frame,
		Padding = UDim.new(0, 4)
	})

	local headerbtn = create("TextButton", {
		Parent = frame,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = theme.buttonbackground,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
		BorderSizePixel = 0
	})
	addcorner(headerbtn)

	local headerlabel = create("TextLabel", {
		Parent = headerbtn,
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = title .. "  " .. openicon,
		TextColor3 = theme.accentfill,
		Font = theme.fontbody,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
		BorderSizePixel = 0
	})

	local closebar = create("Frame", {
		Parent = frame,
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		ZIndex = 2,
		BorderSizePixel = 0
	})

	local closebtn = create("TextButton", {
		Parent = closebar,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = theme.inputbackground,
		Text = "Close  ×",
		TextColor3 = theme.textsecondary,
		Font = theme.fontbody,
		TextSize = 12,
		ZIndex = 2,
		BorderSizePixel = 0
	})
	addcorner(closebtn, 4)

	local list = create("ScrollingFrame", {
		Parent = frame,
		Size = UDim2.new(1, 0, 0, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 0,
		ScrollBarImageColor3 = theme.accentfill,
		BackgroundColor3 = theme.inputbackground,
		ClipsDescendants = true,
		Visible = true,
		ZIndex = 2,
		BorderSizePixel = 0
	})
	addcorner(list, 6)
	create("UIListLayout", {
		Parent = list,
		Padding = UDim.new(0, optionpadding)
	})
	create("UIPadding", {
		Parent = list,
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4)
	})

	local dropdown = {
		frame = frame,
		content = list,
		multiselect = multiselect and true or false,
		selected = {},
		options = {}
	}

	local isopen = true

	local function updateheight()
		local count = #dropdown.options
		local h = 0
		if count > 0 then
			h = math.min(count * optionheight + (count - 1) * optionpadding + 8, maxheight)
		end
		list.Size = UDim2.new(1, 0, 0, h)
	end

	local function setzindex(z)
		frame.ZIndex = z
		headerbtn.ZIndex = z
		headerlabel.ZIndex = z
		closebar.ZIndex = z
		closebtn.ZIndex = z
		list.ZIndex = z
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("GuiObject") then
				child.ZIndex = z
			end
		end
	end

	function dropdown:setopen(state)
		isopen = state
		list.Visible = state
		closebar.Visible = state
		headerlabel.Text = title .. "  " .. (state and openicon or closeicon)
		setzindex(state and 10 or 2)
		if state and lib then
			for _, other in ipairs(lib.dropdowns) do
				if other ~= dropdown and other.isexpanded and other:isexpanded() then
					other:setopen(false)
				end
			end
		end
	end

	function dropdown:isexpanded()
		return isopen
	end

	function dropdown:addoption(text, callback)
		local btn = create("TextButton", {
			Parent = list,
			Size = UDim2.new(1, 0, 0, optionheight),
			BackgroundTransparency = 1,
			Text = "  " .. text,
			TextColor3 = Color3.fromRGB(220, 190, 255),
			Font = Enum.Font.PermanentMarker,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = isopen and 10 or 2,
			AutoButtonColor = false,
			BorderSizePixel = 0
		})

		local selected = false
		local option

		local function refresh()
			if selected then
				btn.BackgroundTransparency = 0
				btn.BackgroundColor3 = theme.accentselected
				btn.TextColor3 = theme.textprimary
				btn.Text = (dropdown.multiselect and "✓ " or "  ") .. text
			else
				btn.BackgroundTransparency = 1
				btn.TextColor3 = Color3.fromRGB(220, 190, 255)
				btn.Text = "  " .. text
			end
		end

		local function setselected(state)
			selected = state
			refresh()
			dropdown.selected[text] = state or nil
		end

		btn.MouseEnter:Connect(function()
			if not selected then
				btn.BackgroundTransparency = 0
				btn.BackgroundColor3 = Color3.fromRGB(30, 15, 50)
			end
		end)

		btn.MouseLeave:Connect(function()
			if not selected then
				btn.BackgroundTransparency = 1
			end
		end)

		btn.Activated:Connect(function()
			if dropdown.multiselect then
				setselected(not selected)
				if callback then
					callback(selected)
				end
			else
				for _, opt in ipairs(dropdown.options) do
					if opt ~= option then
						opt.setselected(false)
					end
				end
				setselected(true)
				if callback then
					callback()
				end
			end
		end)

		option = {
			button = btn,
			text = text,
			setselected = setselected
		}
		table.insert(dropdown.options, option)
		updateheight()
		return btn
	end

	function dropdown:removeoption(btn)
		if not btn then
			return
		end
		for i, opt in ipairs(dropdown.options) do
			if opt.button == btn then
				dropdown.selected[opt.text] = nil
				table.remove(dropdown.options, i)
				break
			end
		end
		btn:Destroy()
		updateheight()
	end

	function dropdown:clear()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		dropdown.options = {}
		dropdown.selected = {}
		updateheight()
	end

	function dropdown:getselected()
		local result = {}
		for _, opt in ipairs(dropdown.options) do
			if dropdown.selected[opt.text] then
				table.insert(result, opt.text)
			end
		end
		return result
	end

	headerbtn.Activated:Connect(function()
		dropdown:setopen(not isopen)
	end)

	closebtn.Activated:Connect(function()
		dropdown:setopen(false)
	end)

	if options then
		for _, opt in ipairs(options) do
			dropdown:addoption(opt.Text, opt.Callback)
		end
	end

	if lib then
		table.insert(lib.dropdowns, dropdown)
	end

	dropdown:setopen(true)
	return dropdown
end

return library
