	local footer = create("Frame", {
		Parent = panel,
		Size = UDim2.new(1, 0, 0, footerheight),
		Position = UDim2.new(0, 0, 1, -(footerheight + timerheight)),
		BackgroundColor3 = theme.headerbackground,
