		Parent = togglebtn,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 200, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 80, 255))
		}),
