	})
	corner(box, 5)

	box.FocusLost:Connect(function(enter)
		if callback then callback(box.Text, enter) end
	end)
	return box
end

function tabpage:AddSlider(label, min, max, default, callback, useside)
	local parent = useside and self.side or self.main
	min = min or 0
	max = max or 100
	default = math.clamp(default or min, min, max)

	local frame = create("Frame", {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = theme.buttonbackground
	})
	corner(frame)
	stroke(frame, Color3.fromRGB(45, 62, 76), 1)

	create("TextLabel", {
		Parent = frame,
		Size = UDim2.new(1, -70, 0, 20),
		Position = UDim2.new(0, 10, 0, 4),
		BackgroundTransparency = 1,
		Text = label,
		TextColor3 = theme.textmuted,
		Font = theme.fontbody,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left
	})

	local valuebox = create("TextBox", {
		Parent = frame,
		Size = UDim2.new(0, 50, 0, 20),
		Position = UDim2.new(1, -60, 0, 4),
		BackgroundColor3 = theme.inputbackground,
		TextColor3 = theme.textprimary,
		Font = theme.fontbody,
		TextSize = 12,
		Text = tostring(default),
		ClearTextOnFocus = false
	})
	corner(valuebox, 5)

	local track = create("Frame", {
		Parent = frame,
		Size = UDim2.new(1, -20, 0, 6),
		Position = UDim2.new(0, 10, 1, -14),
		BackgroundColor3 = theme.inputbackground
	})
	corner(track, 3)

	local fill = create("Frame", {
		Parent = track,
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = theme.accentfill
	})
	corner(fill, 3)

	local knob = create("Frame", {
		Parent = track,
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(0, -6, 0.5, -6),
		BackgroundColor3 = theme.textprimary,
		ZIndex = 5
	})
	corner(knob, 6)

	local value = default
	local function set(v, skiptext)
		v = math.clamp(v, min, max)
		value = v
		local ratio = (max - min) == 0 and 0 or (v - min) / (max - min)
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		knob.Position = UDim2.new(ratio, -6, 0.5, -6)
		if not skiptext then
			valuebox.Text = tostring(math.floor(v * 100) / 100)
		end
		if callback then callback(v) end
	end
	set(default)

	local sliding = false
	local function updateslider(x)
		local ratio = (x - track.AbsolutePosition.X) / track.AbsoluteSize.X
		set(min + ratio * (max - min))
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			updateslider(input.Position.X)
		end
	end)

	track.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	userinputservice.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateslider(input.Position.X)
		end
	end)

	userinputservice.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	valuebox.FocusLost:Connect(function()
		local n = tonumber(valuebox.Text)
		if n then
			set(n, true)
			valuebox.Text = tostring(value)
		else
			valuebox.Text = tostring(value)
		end
	end)

	return {
		Set = set,
		Get = function() return value end
	}
end

function tabpage:AddDropdown(label, options, useside, multiselect)
	if useside == nil then useside = true end
	local parent = useside and self.side or self.main
	local lib = self.library

	local optionheight = 24
	local optionpadding = 2
	local maxheight = 150

	local container = create("Frame", {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 2
	})
	create("UIListLayout", { Parent = container, Padding = UDim.new(0, 4) })

	local header = create("TextButton", {
		Parent = container,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = theme.buttonbackground,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2
	})
	corner(header)

	local headerlabel = create("TextLabel", {
		Parent = header,
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = label .. " " .. arrowopen,
		TextColor3 = theme.accentfill,
		Font = theme.fontbody,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2
	})

	local closebar = create("Frame", {
		Parent = container,
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		ZIndex = 2
	})

	local closebtn = create("TextButton", {
		Parent = closebar,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = theme.inputbackground,
		Text = "Close ×",
		TextColor3 = theme.textsecondary,
		Font = theme.fontbody,
		TextSize = 12,
		ZIndex = 2
	})
	corner(closebtn, 4)

	local list = create("ScrollingFrame", {
		Parent = container,
		Size = UDim2.new(1, 0, 0, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		BackgroundColor3 = theme.inputbackground,
		ClipsDescendants = true,
		Visible = true,
		ZIndex = 2
	})
	corner(list, 6)
	create("UIListLayout", { Parent = list, Padding = UDim.new(0, optionpadding) })
	create("UIPadding", {
		Parent = list,
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4)
	})

	local dropdown = {
		frame = container,
		content = list,
		multiselect = multiselect and true or false,
		selected = {},
		_options = {}
	}

	local expanded = true

	local function resize()
		local count = #dropdown._options
		local h = 0
		if count > 0 then
			h = math.min(count * optionheight + (count - 1) * optionpadding + 8, maxheight)
		end
		list.Size = UDim2.new(1, 0, 0, h)
	end

	local function setz(z)
		container.ZIndex = z
		header.ZIndex = z
		headerlabel.ZIndex = z
		closebar.ZIndex = z
		closebtn.ZIndex = z
		list.ZIndex = z
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("GuiObject") then
				child.ZIndex = z
			end
		end
	end

	function dropdown:SetOpen(state)
		expanded = state
		list.Visible = state
		closebar.Visible = state
		headerlabel.Text = label .. " " .. (state and arrowopen or arrowclosed)
		setz(state and 10 or 2)
		if state and lib then
			for _, other in ipairs(lib.dropdowns) do
				if other ~= dropdown and other._IsExpanded and other._IsExpanded() then
					other:SetOpen(false)
				end
			end
		end
	end

	dropdown._IsExpanded = function()
		return expanded
	end

	function dropdown:AddOption(text, callback)
		local opt = create("TextButton", {
			Parent = list,
			Size = UDim2.new(1, 0, 0, optionheight),
			BackgroundTransparency = 1,
			Text = " " .. text,
			TextColor3 = Color3.fromRGB(198, 214, 224),
			Font = Enum.Font.PermanentMarker,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = expanded and 10 or 2,
			AutoButtonColor = false
		})

		local selected = false
		local entry

		local function refresh()
			if selected then
				opt.BackgroundTransparency = 0
				opt.BackgroundColor3 = theme.accentselected
				opt.TextColor3 = theme.textprimary
				opt.Text = (dropdown.multiselect and "✓ " or " ") .. text
			else
				opt.BackgroundTransparency = 1
				opt.TextColor3 = Color3.fromRGB(198, 214, 224)
				opt.Text = " " .. text
			end
		end

		local function setselected(state)
			selected = state
			refresh()
			dropdown.selected[text] = state or nil
		end

		opt.MouseEnter:Connect(function()
			if not selected then
				opt.BackgroundTransparency = 0
				opt.BackgroundColor3 = Color3.fromRGB(20, 32, 44)
			end
		end)

		opt.MouseLeave:Connect(function()
			if not selected then
				opt.BackgroundTransparency = 1
			end
		end)

		opt.Activated:Connect(function()
			if dropdown.multiselect then
				setselected(not selected)
				if callback then callback(selected) end
			else
				for _, other in ipairs(dropdown._options) do
					if other ~= entry then
						other.SetSelected(false)
					end
				end
				setselected(true)
				if callback then callback() end
			end
		end)

		entry = { Button = opt, Text = text, SetSelected = setselected }
		table.insert(dropdown._options, entry)
		resize()
		return opt
	end

	function dropdown:RemoveOption(btn)
		if not btn then return end
		for i, entry in ipairs(dropdown._options) do
			if entry.Button == btn then
				dropdown.selected[entry.Text] = nil
				table.remove(dropdown._options, i)
				break
			end
		end
		btn:Destroy()
		resize()
	end

	function dropdown:Clear()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		dropdown._options = {}
		dropdown.selected = {}
		resize()
	end

	function dropdown:GetSelected()
		local result = {}
		for _, entry in ipairs(dropdown._options) do
			if dropdown.selected[entry.Text] then
				table.insert(result, entry.Text)
			end
		end
		return result
	end

	header.Activated:Connect(function()
		dropdown:SetOpen(not expanded)
	end)

	closebtn.Activated:Connect(function()
		dropdown:SetOpen(false)
	end)

	if options then
		for _, opt in ipairs(options) do
			dropdown:AddOption(opt.Text, opt.Callback)
		end
	end

	if lib then
		table.insert(lib.dropdowns, dropdown)
	end

	dropdown:SetOpen(true)
	return dropdown
end

return library
