}

local cornerradius = 10
local smallradius = 7
local minwidth = 420
local minheight = 300
local headerheight = 35
local footerheight = 50
local statusbarheight = 22
local mainratio = 0.55
local arrowopen = "▾"
local arrowclosed = "▸"

local function create(class, props)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	return inst
end

local function corner(parent, radius)
	return create("UICorner", {
		Parent = parent,
		CornerRadius = UDim.new(0, radius or smallradius)
	})
end

local function stroke(parent, color, thickness)
	return create("UIStroke", {
		Parent = parent,
		Color = color or theme.accentstroke,
		Thickness = thickness or 1.5
	})
end

local function formattime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local days = math.floor(seconds / 86400)
	local hours = math.floor((seconds % 86400) / 3600)
	local mins = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60
	return string.format("%dD / %dH / %dM / %dS", days, hours, mins, secs)
end

local library = {}
library.__index = library

function library.new(config)
	config = config or {}
	local self = setmetatable({}, library)
	self.tabs = {}
	self.taboffsets = {}
	self.selectedindex = 1
	self.dropdowns = {}

	local screengui = create("ScreenGui", {
		Name = config.Name or "e",
		ResetOnSpawn = false,
		Parent = coregui
	})
	self.screengui = screengui

	local togglebtn = create("TextButton", {
		Parent = screengui,
		Size = UDim2.new(0, 45, 0, 45),
		Position = UDim2.new(0.05, 0, 0.1, 0),
		BackgroundColor3 = theme.headerbackground,
		Text = "",
		AutoButtonColor = false
	})
	corner(togglebtn, 12)

	create("UIGradient", {
		Parent = togglebtn,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.new(0.75, 0.87, 0.93))
		}),
		Rotation = 45
	})

	local togglestroke = stroke(togglebtn)
	create("UIGradient", {
		Parent = togglestroke,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(0.7, 0.9, 1)),
			ColorSequenceKeypoint.new(1, Color3.new(0.2, 0.5, 0.65))
		}),
		Rotation = 45
	})

	create("TextLabel", {
		Parent = togglebtn,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = config.ToggleLabel or "T",
		Font = theme.font,
		TextSize = 26,
		TextColor3 = theme.textprimary
	})

	local toggledragging = false
	local toggledragstart
	local toggledragpos
	local togglemoved = false

	togglebtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			toggledragging = true
			togglemoved = false
			toggledragstart = input.Position
			toggledragpos = togglebtn.Position
		end
	end)

	togglebtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			toggledragging = false
		end
	end)

	local width = config.Width or 680
	local height = config.Height or 460

	local panel = create("Frame", {
		Parent = screengui,
		Size = UDim2.new(0, width, 0, height),
		Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2),
		BackgroundColor3 = theme.background,
		BorderSizePixel = 0,
		Active = true,
		ClipsDescendants = true,
		Visible = true
	})
	corner(panel, cornerradius)
	stroke(panel)
	self.panel = panel

	local header = create("Frame", {
		Parent = panel,
		Size = UDim2.new(1, 0, 0, headerheight),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundColor3 = theme.headerbackground
	})
	corner(header, cornerradius)

	create("TextLabel", {
		Parent = header,
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.new(0, 8, 0, 0),
		BackgroundTransparency = 1,
		Text = config.Title or "e",
		TextColor3 = theme.textprimary,
		Font = theme.font,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left
	})

	local sidebar = create("Frame", {
		Parent = panel,
		Size = UDim2.new(0, 140, 1, -(headerheight + footerheight + statusbarheight)),
		Position = UDim2.new(0, 0, 0, headerheight),
		BackgroundColor3 = theme.sidebarbackground
	})

	local indicator = create("Frame", {
		Parent = sidebar,
		Size = UDim2.new(0, 4, 0, 32),
		Position = UDim2.new(0, 5, 0, 10),
		BackgroundColor3 = theme.accentfill
	})
	corner(indicator, 2)
	self.indicator = indicator

	local tablist = create("ScrollingFrame", {
		Parent = sidebar,
		Size = UDim2.new(1, -5, 1, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 0,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0)
	})
	create("UIListLayout", { Parent = tablist, Padding = UDim.new(0, 5) })
	create("UIPadding", { Parent = tablist, PaddingTop = UDim.new(0, 10) })
	self.tablist = tablist

	local content = create("Frame", {
		Parent = panel,
		Size = UDim2.new(1, -145, 1, -(headerheight + footerheight + statusbarheight)),
		Position = UDim2.new(0, 145, 0, headerheight),
		BackgroundTransparency = 1
	})
	self.content = content

	local footer = create("Frame", {
		Parent = panel,
		Size = UDim2.new(1, 0, 0, footerheight),
		Position = UDim2.new(0, 0, 1, -(footerheight + statusbarheight)),
		BackgroundColor3 = theme.headerbackground
	})

	local avatar = create("ImageLabel", {
		Parent = footer,
		Size = UDim2.new(0, 34, 0, 34),
		Position = UDim2.new(0, 8, 0.5, -17),
		BackgroundColor3 = theme.inputbackground,
		Image = config.AvatarImage or ""
	})
	corner(avatar, 17)
	stroke(avatar, theme.accentstroke, 1)

	create("TextLabel", {
		Parent = footer,
		Size = UDim2.new(1, -58, 1, 0),
		Position = UDim2.new(0, 50, 0, 0),
		BackgroundTransparency = 1,
		Text = config.FooterText or "",
		TextColor3 = theme.textprimary,
		Font = theme.font,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left
	})

	local statusbar = create("Frame", {
		Parent = panel,
		Size = UDim2.new(1, 0, 0, statusbarheight),
		Position = UDim2.new(0, 0, 1, -statusbarheight),
		BackgroundColor3 = theme.accentselected
	})
	corner(statusbar, cornerradius)

	local timerlabel = create("TextLabel", {
		Parent = statusbar,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = theme.textprimary,
		Font = theme.fontbody,
		TextSize = 12
	})
	self.timerlabel = timerlabel

	local starttime = os.clock()
	function self:ResetTimer()
		starttime = os.clock()
	end

	timerlabel.Text = formattime(0)
	local accumulator = 0
	runservice.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 1 then
			accumulator -= 1
			timerlabel.Text = formattime(os.clock() - starttime)
		end
	end)

	local resizehandle = create("TextButton", {
		Parent = panel,
		Size = UDim2.new(0, 18, 0, 18),
		Position = UDim2.new(1, -18, 1, -18),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 10
	})

	local open = true
	togglebtn.MouseButton1Click:Connect(function()
		if togglemoved then return end
		open = not open
		panel.Visible = open
	end)

	self.Open = function()
		open = true
		panel.Visible = true
	end
	self.Close = function()
		open = false
		panel.Visible = false
	end

	local dragging = false
	local dragstart
	local dragpos
	local resizing = false
	local resizestart
	local resizesize

	local function ondragstart(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragstart = input.Position
			dragpos = panel.Position
		end
	end

	local function ondragend(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end

	header.InputBegan:Connect(ondragstart)
	header.InputEnded:Connect(ondragend)
	sidebar.InputBegan:Connect(ondragstart)
	sidebar.InputEnded:Connect(ondragend)
	tablist.InputBegan:Connect(ondragstart)
	tablist.InputEnded:Connect(ondragend)
	content.InputBegan:Connect(ondragstart)
	content.InputEnded:Connect(ondragend)
	footer.InputBegan:Connect(ondragstart)
	footer.InputEnded:Connect(ondragend)
	statusbar.InputBegan:Connect(ondragstart)
	statusbar.InputEnded:Connect(ondragend)

	resizehandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			resizestart = input.Position
			resizesize = panel.Size
		end
	end)

	resizehandle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			resizing = false
		end
	end)

	userinputservice.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		if dragging then
			local delta = input.Position - dragstart
			panel.Position = UDim2.new(
				dragpos.X.Scale, dragpos.X.Offset + delta.X,
				dragpos.Y.Scale, dragpos.Y.Offset + delta.Y
			)
		elseif resizing then
			local delta = input.Position - resizestart
			local neww = math.max(minwidth, resizesize.X.Offset + delta.X)
			local newh = math.max(minheight, resizesize.Y.Offset + delta.Y)
			panel.Size = UDim2.new(resizesize.X.Scale, neww, resizesize.Y.Scale, newh)
		elseif toggledragging then
			local delta = input.Position - toggledragstart
			if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then
				togglemoved = true
			end
			togglebtn.Position = UDim2.new(
				toggledragpos.X.Scale, toggledragpos.X.Offset + delta.X,
				toggledragpos.Y.Scale, toggledragpos.Y.Offset + delta.Y
			)
		end
	end)

	self._ondragstart = ondragstart
	self._ondragend = ondragend

	return self
end

local tabpage = {}
tabpage.__index = tabpage

function library:AddTab(name)
	local index = #self.tabs + 1

	local btn = create("TextButton", {
		Parent = self.tablist,
		Size = UDim2.new(1, -15, 0, 32),
		BackgroundColor3 = theme.buttonbackground,
		BackgroundTransparency = 1,
		Text = " " .. name,
		TextColor3 = theme.textsecondary,
		Font = theme.font,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left
	})
	corner(btn)

	btn.MouseEnter:Connect(function()
		if btn.BackgroundTransparency == 1 then
			tweenservice:Create(btn, TweenInfo.new(0.15), {
				BackgroundTransparency = 0,
				BackgroundColor3 = Color3.fromRGB(20, 32, 44)
			}):Play()
		end
	end)

	btn.MouseLeave:Connect(function()
		if btn.TextColor3 ~= theme.textprimary then
			tweenservice:Create(btn, TweenInfo.new(0.15), {
				BackgroundTransparency = 1
			}):Play()
		end
	end)

	local page = create("Frame", {
		Parent = self.content,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Visible = index == 1
	})

	local main = create("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(mainratio, -4, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0)
	})
	create("UIListLayout", { Parent = main, Padding = UDim.new(0, 8) })
	create("UIPadding", {
		Parent = main,
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8)
	})

	create("Frame", {
		Parent = page,
		Size = UDim2.new(0, 1, 1, -12),
		Position = UDim2.new(mainratio, 0, 0, 6),
		BackgroundColor3 = theme.divider,
		BorderSizePixel = 0
	})

	local side = create("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(1 - mainratio, -4, 1, 0),
		Position = UDim2.new(mainratio, 4, 0, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0)
	})
	create("UIListLayout", { Parent = side, Padding = UDim.new(0, 8) })
	create("UIPadding", {
		Parent = side,
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8)
	})

	if self._ondragstart and self._ondragend then
		main.InputBegan:Connect(self._ondragstart)
		main.InputEnded:Connect(self._ondragend)
		side.InputBegan:Connect(self._ondragstart)
		side.InputEnded:Connect(self._ondragend)
		page.InputBegan:Connect(self._ondragstart)
		page.InputEnded:Connect(self._ondragend)
	end

	table.insert(self.tabs, { Button = btn, Page = page })
	table.insert(self.taboffsets, 10 + (index - 1) * 37)

	btn.MouseButton1Click:Connect(function()
		self:SelectTab(index)
	end)

	return setmetatable({
		page = page,
		main = main,
		side = side,
		library = self
	}, tabpage)
end

function library:SelectTab(index)
	self.selectedindex = index
	for i, tab in ipairs(self.tabs) do
		tab.Page.Visible = (i == index)
		if i == index then
			tweenservice:Create(tab.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 0,
				BackgroundColor3 = theme.accentselected,
				TextColor3 = theme.textprimary
			}):Play()
		else
			tweenservice:Create(tab.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 1,
				TextColor3 = theme.textsecondary
			}):Play()
		end
	end
	tweenservice:Create(self.indicator, TweenInfo.new(0.2), {
		Position = UDim2.new(0, 5, 0, self.taboffsets[index] or 10)
	}):Play()
end

