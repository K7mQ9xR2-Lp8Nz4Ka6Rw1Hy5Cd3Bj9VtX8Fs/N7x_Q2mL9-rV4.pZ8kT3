	})
	addcorner(avatar, 17)
	addstroke(avatar, theme.accentstroke, 1)

	create("TextLabel", {
		Parent = footer,
		Size = UDim2.new(1, -58, 1, 0),
		Position = UDim2.new(0, 50, 0, 0),
		BackgroundTransparency = 1,
		Text = config.FooterText or "",
		TextColor3 = theme.textprimary,
		Font = theme.font,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		BorderSizePixel = 0
	})

	local timerbar = create("Frame", {
		Parent = panel,
		Size = UDim2.new(1, 0, 0, timerheight),
		Position = UDim2.new(0, 0, 1, -timerheight),
		BackgroundColor3 = theme.accentselected,
		BorderSizePixel = 0
	})
	addcorner(timerbar, cornerradius)

	local timerlabel = create("TextLabel", {
		Parent = timerbar,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = theme.textprimary,
		Font = theme.fontbody,
		TextSize = 12,
		BorderSizePixel = 0
	})
	self.timerlabel = timerlabel

	local starttime = os.clock()
	function self:resettimer()
		starttime = os.clock()
	end
	timerlabel.Text = formattime(0)

	local accum = 0
	runservice.Heartbeat:Connect(function(dt)
		accum += dt
		if accum >= 1 then
			accum -= 1
			timerlabel.Text = formattime(os.clock() - starttime)
		end
	end)

	local resizehandle = create("TextButton", {
		Parent = panel,
		Size = UDim2.new(0, 18, 0, 18),
		Position = UDim2.new(1, -18, 1, -18),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 10,
		BorderSizePixel = 0
	})

	local isopen = true
	togglebtn.MouseButton1Click:Connect(function()
		if wasdragged then
			return
		end
		isopen = not isopen
		panel.Visible = isopen
	end)

	self.open = function()
		isopen = true
		panel.Visible = true
	end

	self.close = function()
		isopen = false
		panel.Visible = false
	end

	local draggingpanel = false
	local paneldragstart
	local panelstartpos

	local resizing = false
	local resizestart
	local resizestartsize

	local function ondragstart(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingpanel = true
			paneldragstart = input.Position
			panelstartpos = panel.Position
		end
	end

	local function ondragend(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingpanel = false
		end
	end

	header.InputBegan:Connect(ondragstart)
	header.InputEnded:Connect(ondragend)
	sidebar.InputBegan:Connect(ondragstart)
	sidebar.InputEnded:Connect(ondragend)
	tablist.InputBegan:Connect(ondragstart)
	tablist.InputEnded:Connect(ondragend)
	content.InputBegan:Connect(ondragstart)
	content.InputEnded:Connect(ondragend)
	footer.InputBegan:Connect(ondragstart)
	footer.InputEnded:Connect(ondragend)
	timerbar.InputBegan:Connect(ondragstart)
	timerbar.InputEnded:Connect(ondragend)

	resizehandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			resizestart = input.Position
			resizestartsize = panel.Size
		end
	end)

	resizehandle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			resizing = false
		end
	end)

	userinputservice.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		if draggingpanel then
			local delta = input.Position - paneldragstart
			panel.Position = UDim2.new(
				panelstartpos.X.Scale, panelstartpos.X.Offset + delta.X,
				panelstartpos.Y.Scale, panelstartpos.Y.Offset + delta.Y
			)
		elseif resizing then
			local delta = input.Position - resizestart
			local newwidth = math.max(minwidth, resizestartsize.X.Offset + delta.X)
			local newheight = math.max(minheight, resizestartsize.Y.Offset + delta.Y)
			panel.Size = UDim2.new(resizestartsize.X.Scale, newwidth, resizestartsize.Y.Scale, newheight)
		elseif draggingtoggle then
			local delta = input.Position - dragstart
			if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then
				wasdragged = true
			end
			togglebtn.Position = UDim2.new(
				startpos.X.Scale, startpos.X.Offset + delta.X,
				startpos.Y.Scale, startpos.Y.Offset + delta.Y
			)
		end
	end)

	self.ondragstart = ondragstart
	self.ondragend = ondragend

	return self
end

local tabmt = {}
tabmt.__index = tabmt

function library:addtab(name)
	local index = #self.tabs + 1

	local button = create("TextButton", {
		Parent = self.tablist,
		Size = UDim2.new(1, -15, 0, 32),
		BackgroundColor3 = theme.buttonbackground,
		BackgroundTransparency = 1,
		Text = "   " .. name,
		TextColor3 = theme.textsecondary,
		Font = theme.font,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		BorderSizePixel = 0
	})
	addcorner(button)

	button.MouseEnter:Connect(function()
		if button.BackgroundTransparency == 1 then
			tweenservice:Create(button, TweenInfo.new(0.15), {
				BackgroundTransparency = 0,
				BackgroundColor3 = Color3.fromRGB(30, 15, 50)
			}):Play()
		end
	end)

	button.MouseLeave:Connect(function()
		if button.TextColor3 ~= theme.textprimary then
			tweenservice:Create(button, TweenInfo.new(0.15), {
				BackgroundTransparency = 1
			}):Play()
		end
	end)

	local page = create("Frame", {
		Parent = self.content,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Visible = index == 1,
		BorderSizePixel = 0
	})

	local main = create("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(contentsplit, 0, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollBarImageColor3 = theme.accentfill,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0)
	})
	create("UIListLayout", {
		Parent = main,
		Padding = UDim.new(0, 8)
	})
	create("UIPadding", {
		Parent = main,
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8)
	})

	local side = create("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(1 - contentsplit, 0, 1, 0),
		Position = UDim2.new(contentsplit, 0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollBarImageColor3 = theme.accentfill,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0)
	})
	create("UIListLayout", {
		Parent = side,
		Padding = UDim.new(0, 8)
	})
	create("UIPadding", {
		Parent = side,
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8)
	})

	if self.ondragstart and self.ondragend then
		main.InputBegan:Connect(self.ondragstart)
		main.InputEnded:Connect(self.ondragend)
		side.InputBegan:Connect(self.ondragstart)
		side.InputEnded:Connect(self.ondragend)
		page.InputBegan:Connect(self.ondragstart)
		page.InputEnded:Connect(self.ondragend)
	end

	table.insert(self.tabs, {
		button = button,
		page = page
	})
	table.insert(self.taboffsets, 10 + (index - 1) * 37)

	button.MouseButton1Click:Connect(function()
		self:selecttab(index)
	end)

	return setmetatable({
		page = page,
		main = main,
		side = side,
		library = self
	}, tabmt)
end

function library:selecttab(index)
	self.selectedindex = index
	for i, tab in ipairs(self.tabs) do
		tab.page.Visible = (i == index)
		if i == index then
			tweenservice:Create(tab.button, TweenInfo.new(0.15), {
				BackgroundTransparency = 0,
				BackgroundColor3 = theme.accentselected,
				TextColor3 = theme.textprimary
			}):Play()
		else
			tweenservice:Create(tab.button, TweenInfo.new(0.15), {
				BackgroundTransparency = 1,
				TextColor3 = theme.textsecondary
			}):Play()
		end
	end
	tweenservice:Create(self.indicator, TweenInfo.new(0.2), {
		Position = UDim2.new(0, 5, 0, self.taboffsets[index] or 10)
	}):Play()
end

