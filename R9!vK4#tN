	local header = create("Frame", {
		Parent = panel,
		Size = UDim2.new(1, 0, 0, headerheight),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundColor3 = theme.headerbackground,
		BorderSizePixel = 0
	})
