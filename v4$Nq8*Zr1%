local function applyAntiFling()
	if not antiFlingEnabled or not LocalPlayer.Character then
		return
	end
	local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local existing = hrp:FindFirstChild("BodyVelocity")
	if existing and existing.MaxForce == Vector3.new(100000, 0, 100000) then
		existing:Destroy()
	end
	local bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = Vector3.new(100000, 0, 100000)
	bodyVelocity.Velocity = Vector3.new(0, 0, 0)
	bodyVelocity.P = 1250
	bodyVelocity.Parent = hrp
end

local function removeAntiFling()
	if not LocalPlayer.Character then
