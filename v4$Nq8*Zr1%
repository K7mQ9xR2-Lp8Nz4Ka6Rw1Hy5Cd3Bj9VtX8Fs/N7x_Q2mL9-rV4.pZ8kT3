local function startKillTp(mode)
	currentKillTpMode = mode
	if killTpConnection then
		killTpConnection:Disconnect()
		killTpConnection = nil
	end
	killTpConnection = RunService.Heartbeat:Connect(function()
		if not currentKillTpMode then
			return
		end
		if currentKillTpMode == "pack" then
			doPackSpamStep()
		elseif currentKillTpMode == "hp" then
			doHpSpamStep()
		end
		local char = getLocalCharacter()
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		for _, name in ipairs(_G.tpListedPlayers) do
			local target = nil
			for _, player in ipairs(Players:GetPlayers()) do
				if player.Name:lower() == name:lower() then
					target = player
					break
				end
			end
			if target and isAlive(target) then
				local oldCFrame = hrp.CFrame
				hrp.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
				punch()
				local humanoid = target.Character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.Died:Once(function()
						task.wait(0.01)
						if hrp and hrp.Parent then
							hrp.CFrame = oldCFrame
						end
					end)
				end
				break
			end
		end
	end)
end

local function stopKillTp()
	currentKillTpMode = nil
	if killTpConnection then
		killTpConnection:Disconnect()
		killTpConnection = nil
	end
end

