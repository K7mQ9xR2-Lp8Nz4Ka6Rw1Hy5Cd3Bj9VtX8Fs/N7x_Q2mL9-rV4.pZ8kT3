local lastPackSwitch = 0
local packPhase = 0

local function doPackSpamStep()
	local now = tick()
	if now - lastPackSwitch < 0.15 then
		return
	end
	lastPackSwitch = now
	if packPhase == 0 then
		for _, pet in ipairs(uniquePetsFolder:GetChildren()) do
			if pet.Name == "Mighty Monster" then
				equipPetEvent:FireServer("unequipPet", pet)
			end
		end
		local count = 0
		for _, pet in ipairs(uniquePetsFolder:GetChildren()) do
			if pet.Name == "Wild Wizard" and count < 8 then
				equipPetEvent:FireServer("unequipPet", pet)
				equipPetEvent:FireServer("equipPet", pet)
				count += 1
			end
		end
		packPhase = 1
	else
		for _, pet in ipairs(uniquePetsFolder:GetChildren()) do
			if pet.Name == "Wild Wizard" then
				equipPetEvent:FireServer("unequipPet", pet)
			end
		end
		local count = 0
		for _, pet in ipairs(uniquePetsFolder:GetChildren()) do
			if pet.Name == "Mighty Monster" and count < 8 then
				equipPetEvent:FireServer("unequipPet", pet)
				equipPetEvent:FireServer("equipPet", pet)
				count += 1
			end
		end
		packPhase = 0
	end
end

local function doHpSpamStep()
	local now = tick()
	if now - lastPackSwitch < 0.15 then
		return
	end
	lastPackSwitch = now
	local count = 0
	for _, pet in ipairs(uniquePetsFolder:GetChildren()) do
