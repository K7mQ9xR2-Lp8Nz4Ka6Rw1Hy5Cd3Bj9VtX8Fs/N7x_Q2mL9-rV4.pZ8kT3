local function getEffectiveHealth(player)
	if not player then
		return 0
	end
	local durability = player:FindFirstChild("Durability") or (player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Durability"))
	if not durability then
		return 0
	end
	local multiplier = 1
	if player:FindFirstChild("ultimatesFolder") and player.ultimatesFolder:FindFirstChild("Infernal Health") then
		multiplier = multiplier + 0.15 * (player.ultimatesFolder["Infernal Health"].Value or 0)
	end
	if player:FindFirstChild("equippedPets") then
		for _, pet in ipairs(player.equippedPets:GetChildren()) do
			if pet:IsA("ObjectValue") and pet.Value then
				local petName = string.lower(pet.Value.Name)
				if petName:match("mighty") and petName:match("monster") then
					multiplier = multiplier + 0.5
				end
				if petName:match("small") and petName:match("fry") then
					multiplier = multiplier + 0.25
				end
			end
		end
	end
	return durability.Value * multiplier
end

local function getEffectiveDamage(player)
	if not player or not player:FindFirstChild("leaderstats") or not player.leaderstats:FindFirstChild("Strength") then
		return 0
	end
	local base = player.leaderstats.Strength.Value * (1 / 15)
	local multiplier = 1
	if player:FindFirstChild("ultimatesFolder") and player.ultimatesFolder:FindFirstChild("Demon Damage") then
		multiplier = multiplier + 0.1 * (player.ultimatesFolder["Demon Damage"].Value or 0)
	end
	if player:FindFirstChild("equippedPets") then
		for _, pet in ipairs(player.equippedPets:GetChildren()) do
			if pet:IsA("ObjectValue") and pet.Value then
				local petName = string.lower(pet.Value.Name)
				if petName:match("wild") and petName:match("wizard") then
					multiplier = multiplier + 0.5
				end
				if petName:match("chaos") and petName:match("sorcerer") then
					multiplier = multiplier + 0.25
				end
			end
		end
	end
	return base * multiplier
end

local function getLocalRootPart()
	local char = getLocalCharacter()
	return char and char:FindFirstChild("HumanoidRootPart")
end

local autoDetectKillEnabled = false
local autoDetectKillTpEnabled = false
local lastBlacklistAddTime = {}
local lastTpListAddTime = {}
local blacklistHitCounts = {}
local tpListHitCounts = {}

KillingTab:AddToggle("Kill Auto Detect", function(state)
	autoDetectKillEnabled = state
end)

TeleportingTab:AddToggle("Kill Tp Auto Detect", function(state)
	autoDetectKillTpEnabled = state
end)

do
	local detectionRange = 15
	local requiredHits = 3
	local damageTolerance = 0.02
	local guiDamageEvent = ReplicatedStorage:WaitForChild("rEvents"):FindFirstChild("guiDamageEvent")
	if guiDamageEvent then
		guiDamageEvent.OnClientEvent:Connect(function(kind, target, damage)
			if kind ~= "damageShow" then
				return
			end
			if not autoDetectKillEnabled and not autoDetectKillTpEnabled then
				return
			end
			if type(damage) ~= "number" or damage <= 0 then
				return
			end
			local localRoot = getLocalRootPart()
			if not localRoot or target ~= localRoot then
				return
			end
			local candidates = {}
			for _, player in ipairs(Players:GetPlayers()) do
				if player == LocalPlayer then
					continue
				end
				local character = player.Character
				local rootPart = character and character:FindFirstChild("HumanoidRootPart")
				if not rootPart then
					continue
				end
				if (rootPart.Position - localRoot.Position).Magnitude > detectionRange then
					continue
				end
				local estimatedDamage = getEffectiveDamage(player)
				if estimatedDamage > 0 then
					table.insert(candidates, {
						player = player,
						diff = math.abs(estimatedDamage - damage)
					})
				end
			end
			if #candidates == 0 then
				return
			end
			table.sort(candidates, function(a, b)
				return a.diff < b.diff
			end)
			local best = candidates[1]
			local now = tick()
			local function addToBlacklist(player)
				if lastBlacklistAddTime[player] and now - lastBlacklistAddTime[player] < 8 then
					return
				end
				if not isBlacklisted(player) then
					table.insert(_G.blacklistedPlayers, player.Name)
					saveList(BlacklistFile, _G.blacklistedPlayers)
				end
				lastBlacklistAddTime[player] = now
				blacklistHitCounts = {}
			end
			local function addToTpList(player)
				if lastTpListAddTime[player] and now - lastTpListAddTime[player] < 8 then
					return
				end
				if not isTpListed(player) then
					table.insert(_G.tpListedPlayers, player.Name)
					saveList(TpListFile, _G.tpListedPlayers)
				end
				lastTpListAddTime[player] = now
				tpListHitCounts = {}
			end
			local function process(player)
				if autoDetectKillEnabled then
					addToBlacklist(player)
				end
				if autoDetectKillTpEnabled then
					addToTpList(player)
				end
			end
			if best.diff <= damage * damageTolerance then
				process(best.player)
				return
			end
			local hasCloseCompetitors = false
			for idx = 2, #candidates do
				if candidates[idx].diff <= best.diff + damage * damageTolerance then
					hasCloseCompetitors = true
					break
				end
			end
			if autoDetectKillEnabled then
				blacklistHitCounts[best.player] = (blacklistHitCounts[best.player] or 0) + 1
				if not hasCloseCompetitors or blacklistHitCounts[best.player] >= requiredHits then
					addToBlacklist(best.player)
				end
			end
			if autoDetectKillTpEnabled then
				tpListHitCounts[best.player] = (tpListHitCounts[best.player] or 0) + 1
				if not hasCloseCompetitors or tpListHitCounts[best.player] >= requiredHits then
					addToTpList(best.player)
				end
			end
		end)
	end
end

local function updateCombatStats(player)
	if not player then
		enemyHealthLabel.Text = "Enemy Health: N/A"
		enemyDamageLabel.Text = "Enemy Damage: N/A"
		yourHealthLabel.Text = "Your Health: N/A"
		yourDamageLabel.Text = "Your Damage: N/A"
		hitsToKillLabel.Text = "Hits To Kill: N/A"
		return
	end
	local enemyHealth = getEffectiveHealth(player)
	local enemyDamage = getEffectiveDamage(player)
	local yourHealth = getEffectiveHealth(LocalPlayer)
	local yourDamage = getEffectiveDamage(LocalPlayer)
	local hits = "∞"
	if yourDamage > 0 then
		local h = math.ceil(enemyHealth / yourDamage)
		if h > 200 then
			hits = "∞"
		elseif h < 1 then
			hits = "instant"
		else
			hits = tostring(h)
		end
	end
	enemyHealthLabel.Text = string.format("Enemy Health: %s (%s)", formatShort(enemyHealth), formatWithCommas(enemyHealth))
	enemyDamageLabel.Text = string.format("Enemy Damage: %s (%s)", formatShort(enemyDamage), formatWithCommas(enemyDamage))
	yourHealthLabel.Text = string.format("Your Health: %s (%s)", formatShort(yourHealth), formatWithCommas(yourHealth))
	yourDamageLabel.Text = string.format("Your Damage: %s (%s)", formatShort(yourDamage), formatWithCommas(yourDamage))
	hitsToKillLabel.Text = "Hits To Kill: " .. hits
end

